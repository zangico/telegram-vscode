{
  "name": "telegram-sidebar",
  "displayName": "Telegram Sidebar",
  "description": "Telegram for VSCode",
  "version": "2.3.0",
  "publisher": "zangico",
  "icon": "images/icon.png",
  "sponsor": {
    "url": "https://buymeacoffee.com/zangico"
  },
  "categories": [
    "Other"
  ],
  "engines": {
    "vscode": "^1.91.0"
  },
  "activationEvents": [],
  "main": "./src/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/zangico/telegram-vscode"
  },
  "contributes": {
    "commands": [
      {
        "command": "telegram-vscode.openTelegramWeb",
        "title": "Open Telegram in Tab"
      },
      {
        "command": "telegram-vscode.setProxyPassword",
        "title": "Telegram: Set Proxy Password"
      },
      {
        "command": "telegram-vscode.openSettings",
        "title": "Telegram: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "telegram-vscode.buyMeACoffee",
        "title": "Telegram: Buy Me a Coffee",
        "icon": "$(heart)"
      },
      {
        "command": "telegram-vscode.toggleDoNotDisturb",
        "title": "Telegram: Toggle Do Not Disturb"
      },
      {
        "command": "telegram-vscode.sendSelection",
        "title": "Telegram: Copy Selection for Chat"
      },
      {
        "command": "telegram-vscode.toggle",
        "title": "Telegram: Toggle Chat"
      },
      {
        "command": "telegram-vscode.moveView",
        "title": "Telegram: Move View…"
      }
    ],
    "keybindings": [
      {
        "command": "telegram-vscode.toggle",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "telegram-vscode.buyMeACoffee",
          "when": "view == telegramWebview && config.telegram-sidebar.showSupportButton",
          "group": "navigation@1"
        },
        {
          "command": "telegram-vscode.openSettings",
          "when": "view == telegramWebview",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "telegram-vscode.sendSelection",
          "when": "editorHasSelection",
          "group": "9_cutcopypaste@9"
        }
      ]
    },
    "configuration": {
      "title": "Telegram",
      "properties": {
        "telegram-sidebar.server.port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535,
          "default": 49152,
          "scope": "application",
          "order": 10,
          "markdownDescription": "Local port that serves Telegram Web to VS Code. If it is used by another program, the next 9 ports are tried in order. Telegram keeps a separate login for each port, so changing it means logging in again."
        },
        "telegram-sidebar.proxy.type": {
          "type": "string",
          "enum": ["none", "http", "https", "socks4", "socks5"],
          "enumDescriptions": [
            "Connect to Telegram directly.",
            "HTTP proxy (CONNECT).",
            "HTTP proxy reached over TLS.",
            "SOCKS4 proxy (host names resolved by the proxy).",
            "SOCKS5 proxy (host names resolved by the proxy)."
          ],
          "default": "none",
          "scope": "application",
          "order": 0,
          "description": "Proxy used for all Telegram traffic."
        },
        "telegram-sidebar.proxy.host": {
          "type": "string",
          "default": "",
          "scope": "application",
          "order": 1,
          "description": "Proxy host name or IP address. Put IPv6 addresses in square brackets, for example [::1]."
        },
        "telegram-sidebar.proxy.port": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 65535,
          "default": null,
          "scope": "application",
          "order": 2,
          "description": "Proxy port."
        },
        "telegram-sidebar.proxy.username": {
          "type": "string",
          "default": "",
          "scope": "application",
          "order": 3,
          "markdownDescription": "Proxy user name, if the proxy requires authentication. Set the password with the **Telegram: Set Proxy Password** command."
        },
        "telegram-sidebar.zoom": {
          "type": "integer",
          "minimum": 50,
          "maximum": 200,
          "default": 100,
          "scope": "application",
          "order": 30,
          "markdownDescription": "Zoom of the Telegram view, in percent."
        },
        "telegram-sidebar.notifications.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "order": 40,
          "markdownDescription": "Show a VS Code notification for each Telegram notification. The Telegram view must have been opened in this window."
        },
        "telegram-sidebar.notifications.showPreview": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "order": 41,
          "markdownDescription": "Include the message text in notifications."
        },
        "telegram-sidebar.notifications.muteWhileDebugging": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "order": 42,
          "markdownDescription": "Do not show notifications while a debug session is active. Use **Telegram: Toggle Do Not Disturb** to mute them manually."
        },
        "telegram-sidebar.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "order": 50,
          "markdownDescription": "Show the unread chats counter and the Do Not Disturb indicator in the status bar."
        },
        "telegram-sidebar.showSupportButton": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "order": 100,
          "markdownDescription": "Show the heart button in the Telegram sidebar header. Enjoying the extension? [Buy me a coffee](https://buymeacoffee.com/zangico) ☕"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "telegram-sidebar",
          "title": "Telegram",
          "icon": "images/sidebar_icon.svg"
        }
      ]
    },
    "views": {
      "telegram-sidebar": [
        {
          "type": "webview",
          "id": "telegramWebview",
          "name": "Telegram"
        }
      ]
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@types/vscode": "^1.91.0",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "http-proxy-middleware": "^2.0.11",
    "https-proxy-agent": "^7.0.6",
    "socks-proxy-agent": "^8.0.5"
  }
}
